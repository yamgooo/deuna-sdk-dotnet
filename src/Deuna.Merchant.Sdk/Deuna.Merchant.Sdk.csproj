<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Deuna.Merchant.Sdk</AssemblyName>
    <RootNamespace>Deuna.Merchant.Sdk</RootNamespace>

    <!-- NuGet packaging metadata -->
    <PackageId>Deuna.Merchant.Sdk</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Erik Portilla</Authors>
    <RepositoryUrl>https://github.com/yamgooo/deuna-sdk-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yamgooo/deuna-sdk-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Strongly-typed, async, DI-friendly .NET SDK for the DEUNA Merchant Payments API (Banco Pichincha / Ecuador). Supports payment requests, QR code and deeplink generation, payment info queries, cancellations, and refunds with built-in Polly resilience.</Description>
    <PackageTags>deuna;ecuador;banco-pichincha;payments;payment-gateway;qr-code;deeplink;merchant;fintech;dotnet;csharp;resilience;polly</PackageTags>
    <PackageReleaseNotes>https://github.com/yamgooo/deuna-sdk-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Strict build quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deuna.Merchant.Sdk.UnitTests" />
    <InternalsVisibleTo Include="Deuna.Merchant.Sdk.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
